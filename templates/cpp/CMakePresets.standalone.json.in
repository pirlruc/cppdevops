{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Standalone library",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_SHARED_LIBS": "ON"
      }
    },
    {
      "name": "ci-linux",
      "inherits": "default",
      "displayName": "CI Linux (Clang + libc++)",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "IMPROC_WITH_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "targets": ["@CMAKE_TARGET@"]
    }
  ]
}
