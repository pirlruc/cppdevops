# syntax=docker/dockerfile:1
# C++ analysis image on DHI Alpine 3.24. libc++ on this catalog requires
# Clang 20 or newer, so this variant is Clang 20 plus clang20-rtlib.
# Debian stays Clang 18.
# No HEALTHCHECK. kics-scan disable=b03a748a-542d-44f4-bb86-9199ab4fd2d5
# Base tag in a comment for DOCKER-BUILD-003: dhi.io/python:3.13-alpine3.24-dev

FROM dhi.io/python:3.13-alpine3.24-dev@sha256:7d5cbf724a97c21e46828b10c6dc94a2de7a733d5371361b6f427ae5c00a25e5 AS pybuild
COPY --from=ghcr.io/astral-sh/uv:0.12.0@sha256:606e70c71c852d03f611b1e56a195d08648507018a7057fab82c4974c4eae105 \
  /uv /usr/local/bin/uv
COPY requirements-alpine.txt /tmp/requirements.txt
RUN /usr/local/bin/uv venv /opt/venv --python /usr/bin/python3 \
 && /usr/local/bin/uv pip install --python /opt/venv/bin/python --no-cache --require-hashes \
      -r /tmp/requirements.txt \
 && rm -f /tmp/requirements.txt

FROM dhi.io/python:3.13-alpine3.24-dev@sha256:7d5cbf724a97c21e46828b10c6dc94a2de7a733d5371361b6f427ae5c00a25e5

LABEL org.opencontainers.image.title="ci-cpp" \
      org.opencontainers.image.description="C++ analysis toolchain plus vcpkg, Alpine 3.24 variant. Non-root 1000:1000, linux/amd64." \
      org.opencontainers.image.source="https://github.com/pirlruc/cppdevops" \
      org.opencontainers.image.vendor="pirlruc" \
      org.opencontainers.image.licenses="MIT"

ENV PATH="/opt/venv/bin:/opt/vcpkg:/usr/local/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DISABLE_METRICS=1 \
    VCPKG_DEFAULT_BINARY_CACHE=/vcpkg-cache \
    VCPKG_DEFAULT_TRIPLET=x64-linux-libcxx \
    VCPKG_OVERLAY_TRIPLETS=/opt/vcpkg-triplets \
    VCPKG_FORCE_SYSTEM_BINARIES=1

USER root
ARG VCPKG_COMMIT=434307da09bc05b2c86996dccc8b2351fc0d5d37
RUN apk add --no-cache \
      bash=5.3.9-r1 \
      curl=8.20.0-r1 \
      gzip=1.14-r2 \
      linux-headers=7.0.0-r1 \
      nasm=3.01-r0 \
      pkgconf=2.5.1-r0 \
      unzip=6.0-r16 \
      zip=3.0-r13 \
      clang20=20.1.8-r3 \
      clang20-libclang=20.1.8-r3 \
      clang20-extra-tools=20.1.8-r3 \
      clang20-rtlib=0.1.0-r3 \
      llvm20=20.1.8-r1 \
      libc++-dev=22.1.3-r0 \
      llvm-libunwind-dev=22.1.3-r0 \
      cmake=4.2.3-r0 \
      ninja-build=1.13.2-r1 \
      cppcheck=2.21.0-r0 \
      valgrind=3.25.1-r2 \
      doxygen=1.17.0-r0 \
      git=2.54.0-r0 \
 && mkdir -p /usr/local/bin \
 && ln -sf /usr/bin/clang-20 /usr/local/bin/clang \
 && ln -sf /usr/bin/clang++-20 /usr/local/bin/clang++ \
 && ln -sf /usr/lib/llvm20/bin/clang-tidy /usr/local/bin/clang-tidy \
 && ln -sf /usr/lib/llvm20/bin/clang-format /usr/local/bin/clang-format \
 && ln -sf /usr/bin/llvm20-cov /usr/local/bin/llvm-cov \
 && ln -sf /usr/bin/llvm20-profdata /usr/local/bin/llvm-profdata \
 && ln -sf /usr/bin/llvm20-symbolizer /usr/local/bin/llvm-symbolizer \
 && ln -sf /usr/lib/ninja-build/bin/ninja /usr/local/bin/ninja \
 && if ! id -u 1000 >/dev/null 2>&1; then \
      printf 'ci:x:1000:1000::/home/ci:/bin/sh\n' >> /etc/passwd; \
      printf 'ci:x:1000:\n' >> /etc/group; \
    fi \
 && mkdir -p /home/ci /workspace /vcpkg-cache /opt/vcpkg-triplets \
 && curl -fsSL --retry 5 --retry-delay 2 --retry-all-errors -o /tmp/vcpkg.tar.gz \
      "https://github.com/microsoft/vcpkg/archive/${VCPKG_COMMIT}.tar.gz" \
 && tar -xzf /tmp/vcpkg.tar.gz -C /opt \
 && rm -f /tmp/vcpkg.tar.gz \
 && mv "/opt/vcpkg-${VCPKG_COMMIT}" /opt/vcpkg \
 && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics -musl \
 && chown -R 1000:1000 /workspace /home/ci /opt/vcpkg /vcpkg-cache /opt/vcpkg-triplets

COPY --chown=1000:1000 triplets/x64-linux-libcxx.cmake /opt/vcpkg-triplets/x64-linux-libcxx.cmake
COPY --from=pybuild --chown=1000:1000 /opt/venv /opt/venv

WORKDIR /workspace
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} +
USER 1000:1000
ENTRYPOINT []
CMD ["sh"]
